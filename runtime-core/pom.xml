<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.tsanet.connector</groupId>
    <artifactId>tsanet-intercom-connector</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>runtime-core</artifactId>
  <name>runtime-core</name>
  <description>Canvas + webhook runtime. Must not import com.tsanet.* (see docs/decisions.md D6).</description>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <!-- Durable link table (docs/decisions.md D11). Version managed by the Spring Boot
           parent. Raw JDBC on purpose: spring-boot-starter-jdbc would pull in DataSource
           auto-configuration and HikariCP, which fight the hand-built SQLiteDataSource. -->
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <!-- Keep the plain jar as the main artifact so connect-gateway can depend on
               this module; the runnable fat jar gets the -exec classifier. -->
          <classifier>exec</classifier>
        </configuration>
      </plugin>
      <plugin>
        <!-- Publishes the test classes as a test-jar so connect-gateway's SDK gateway
             can extend TsanetGatewayContractTest (the shared gateway contract). -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>test-jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
