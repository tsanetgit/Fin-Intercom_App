# Container App spec template for the Azure test environment. Rendered by
# scripts/azure-poc-deploy.sh via python string.Template (dollar-sign placeholders)
# into a short-lived temp file (it carries secret values once rendered), then applied with
# `az containerapp create --yaml` — an ARM upsert, so the same render both creates
# and updates.
#
# The shape this encodes, and why (docs/AZURE_DEPLOYMENT.md has the diagrams):
#   - TWO containers per replica. The app runs SQLite on /shared (an in-replica
#     EmptyDir volume): WAL mode cannot live on Azure Files SMB — it needs
#     shared-memory mapping, and the symptom is SQLITE_BUSY at the very first
#     connection (hit live 2026-08-08). The links-backup sidecar (same image, shell
#     loop) copies the database pair to /data (Azure Files) every 5 minutes, and once
#     per hour snapshots the copies into /data/hourly/<UTC yyyymmddHH>/ (built in a
#     .tmp dir, atomically mv'd into place, whole directories pruned after 48h), so
#     corruption overwriting the latest copy no longer destroys the only recovery
#     point (#59). Snapshots are crash-consistent file copies, same semantics as the
#     latest copy. NOTE: literal shell dollars in the sidecar command are escaped as
#     $$ for string.Template — keep it that way or the render raises KeyError.
#   - The app container's command restores the LATEST backup from /data before exec'ing
#     the jar, so a replica restart loses at most one backup interval of links; hourly
#     snapshots are for manual point-in-time restore only (docs/AZURE_DEPLOYMENT.md).
#   - min = max = 1: the poller cursor and the SQLite store are single-writer by
#     design, and an always-warm replica is what keeps canvas responses inside
#     Intercom's patience.
# Top-level resource fields: create --yaml requires them (update tolerates their
# absence, which is how the properties-only first draft slipped through against a
# live app).
location: $LOCATION
name: $APP_NAME
type: Microsoft.App/containerApps
# Image pulls authenticate as this user-assigned identity, which holds AcrPull on the
# registry and nothing else (#55). It is a resource of its own, so AcrPull can be
# granted before the app switches to it and it survives the app being recreated.
identity:
  type: UserAssigned
  userAssignedIdentities:
    $PULL_IDENTITY_ID: {}
properties:
  environmentId: $ENVIRONMENT_ID
  configuration:
    activeRevisionsMode: Single
    ingress:
      external: true
      targetPort: 8792
      transport: Auto
    registries:
      - server: $ACR_SERVER
        identity: $PULL_IDENTITY_ID
    secrets:
      - name: tsanet-password
        value: $TSANET_PASSWORD
      - name: intercom-token
        value: $INTERCOM_TOKEN
      - name: intercom-secret
        value: $INTERCOM_SECRET
      - name: tsanet-webhook-secret
        value: $TSANET_WEBHOOK_SECRET_VALUE
      - name: admin-api-secret
        value: $ADMIN_API_SECRET_VALUE
  template:
    scale:
      minReplicas: 1
      maxReplicas: 1
    volumes:
      - name: findata
        storageName: findata
        storageType: AzureFile
      - name: shared
        storageType: EmptyDir
    containers:
      - name: fin-gateway-poc
        image: $IMAGE
        command:
          - /bin/sh
          - -c
          - >-
            cp -f /data/links.db /shared/links.db 2>/dev/null || true;
            cp -f /data/links.db-wal /shared/links.db-wal 2>/dev/null || true;
            cp -f /data/connect-sdk.db /shared/connect-sdk.db 2>/dev/null || true;
            exec java -jar /app.jar
        resources:
          cpu: 0.5
          memory: 1Gi
        volumeMounts:
          - volumeName: findata
            mountPath: /data
          - volumeName: shared
            mountPath: /shared
        env:
          - name: CONNECTOR_TSANET_MODE
            value: sdk
          - name: CONNECTOR_INTERCOM_MODE
            value: rest
          - name: TSANET_API_URL
            value: $TSANET_API_URL
          - name: TSANET_API_USER
            value: $TSANET_API_USER
          - name: TSANET_API_PASSWORD
            secretRef: tsanet-password
          - name: TSANET_AUTH_MODE
            value: $TSANET_AUTH_MODE
          - name: TSANET_ENTRA_TENANT_ID
            value: $TSANET_ENTRA_TENANT_ID
          - name: TSANET_ENTRA_AUDIENCE
            value: $TSANET_ENTRA_AUDIENCE
          - name: INTERCOM_ACCESS_TOKEN
            secretRef: intercom-token
          - name: INTERCOM_DEV_CLIENT_SECRET
            secretRef: intercom-secret
          - name: TSANET_WEBHOOK_SECRET
            secretRef: tsanet-webhook-secret
          - name: INTERCOM_COLLABORATION_TICKET_TYPE_ID
            value: "$TICKET_TYPE_ID"
          - name: INTERCOM_RESOLVED_STATE_ID
            value: "$RESOLVED_STATE_ID"
          - name: INTERCOM_IN_PROGRESS_STATE_ID
            value: "$IN_PROGRESS_STATE_ID"
          - name: INTERCOM_WAITING_STATE_ID
            value: "$WAITING_STATE_ID"
          - name: CONNECTOR_LINKS_STORE
            value: sqlite
          - name: CONNECTOR_LINKS_SQLITE_PATH
            value: /shared/links.db
          - name: TSANET_SDK_SQLITE_PATH
            value: /shared/connect-sdk.db
          - name: CONNECTOR_RECONCILE_ENABLED
            value: "true"
          - name: CONNECTOR_ADMIN_API_SECRET
            secretRef: admin-api-secret
          - name: CONNECTOR_PUBLIC_BASE_URL
            value: "$PUBLIC_BASE_URL"
          # SDK-cache retention (#66): blank keeps the sweep OFF (the bean does not
          # register on blank, so an empty value here is safe by design). Set per
          # member once they name a window, e.g. "30d".
          - name: CONNECTOR_SDK_CACHE_RETENTION
            value: "$SDK_CACHE_RETENTION"
      - name: links-backup
        image: $IMAGE
        command:
          - /bin/sh
          - -c
          - >-
            while true; do sleep 300;
            cp -f /shared/links.db /data/links.db.new 2>/dev/null &&
            cp -f /shared/links.db-wal /data/links.db-wal.new 2>/dev/null;
            mv -f /data/links.db-wal.new /data/links.db-wal 2>/dev/null;
            mv -f /data/links.db.new /data/links.db 2>/dev/null;
            cp -f /shared/connect-sdk.db /data/connect-sdk.db 2>/dev/null;
            H=$$(date -u +%Y%m%d%H);
            if [ ! -d /data/hourly/$$H ]; then
            mkdir -p /data/hourly/.tmp.$$H;
            cp -f /data/links.db /data/hourly/.tmp.$$H/links.db 2>/dev/null;
            cp -f /data/links.db-wal /data/hourly/.tmp.$$H/links.db-wal 2>/dev/null;
            cp -f /data/connect-sdk.db /data/hourly/.tmp.$$H/connect-sdk.db 2>/dev/null;
            mv -f /data/hourly/.tmp.$$H /data/hourly/$$H 2>/dev/null;
            fi;
            find /data/hourly -mindepth 1 -maxdepth 1 -type d -mmin +2880 -exec rm -rf {} + 2>/dev/null;
            done
        resources:
          cpu: 0.25
          memory: 0.5Gi
        volumeMounts:
          - volumeName: findata
            mountPath: /data
          - volumeName: shared
            mountPath: /shared
