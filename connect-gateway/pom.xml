<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.tsanet.connector</groupId>
    <artifactId>tsanet-intercom-connector</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>connect-gateway</artifactId>
  <name>connect-gateway</name>
  <description>SDK-mode assembly: imports the published gateway-engine (docs/decisions.md D6; Fin swap #42) and packages the deployable.</description>

  <properties>
    <!-- 3.0.0 = the engine on connect-library 3.0.0 (tsanetgit/Connect_Gateway#47,
         released as v3.0.0). The TsanetGateway contract and the engine's code are
         unchanged from 2.0.0; the engine's version moves in step with the library
         it pins. On the wire, a case create now also sends "encrypted": false and
         "manifest": null, because connect-library 3.0.0's models are generated
         from a newer Connect spec. -->
    <gateway-engine.version>3.0.0</gateway-engine.version>
    <connect-library.version>3.0.0</connect-library.version>
  </properties>

  <!-- Where the engine resolves from. GitHub Packages needs a token even for
       reads; the `github` server id in settings.xml carries it. -->
  <repositories>
    <repository>
      <id>github</id>
      <name>GitHub Packages - tsanetgit/Connect_Gateway</name>
      <url>https://maven.pkg.github.com/tsanetgit/Connect_Gateway</url>
      <snapshots><enabled>false</enabled></snapshots>
    </repository>
    <!-- The engine's transitive connect-library lives in the Connect_SDK registry.
         Declared explicitly with its own id rather than relying on the id-collision
         behavior between this pom's `github` and the engine pom's `github`: same
         token, second settings server entry. -->
    <repository>
      <id>github-sdk</id>
      <name>GitHub Packages - tsanetgit/Connect_SDK</name>
      <url>https://maven.pkg.github.com/tsanetgit/Connect_SDK</url>
      <snapshots><enabled>false</enabled></snapshots>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>org.tsanet.connector</groupId>
      <artifactId>runtime-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <!-- The published engine (tsanetgit/Connect_Gateway v3.0.0, on the Boot 4 /
           Jackson 3 line from #34). Brings com.tsanet:connect-library 3.0.0
           transitively; this module carries no engine sources since the Fin swap (#42). -->
      <groupId>org.tsanet.connector</groupId>
      <artifactId>gateway-engine</artifactId>
      <version>${gateway-engine.version}</version>
    </dependency>
    <dependency>
      <!-- Declared directly because SdkCacheRetentionSweep compiles against
           com.tsanet.api.storage.CacheRetention (Connect_SDK#66); a direct
           compile-time dependency gets a direct declaration rather than riding the
           engine's graph (D6 forbids com.tsanet.* in runtime-core, not here).
           INVARIANT: this version MUST equal gateway-engine's own connect-library
           pin. Nearest-wins means a mismatch here silently overrides the engine's
           choice (the hazard the pre-1.0.0 revision of this comment was about).
           Asserted by the enforce-connect-library-pin execution below, which fails
           the build at validate when the engine requests a different version than
           this pin (#81). One thing silences that rule without fixing the
           invariant, so it stays a manual check: an exclusion of connect-library
           under gateway-engine removes the engine's request and the rule passes
           (probed on #81). A dependencyManagement pin for connect-library in this
           pom does not silence it (also probed): the direct pin still diverges from
           the engine's request. -->
      <groupId>com.tsanet</groupId>
      <artifactId>connect-library</artifactId>
      <version>${connect-library.version}</version>
    </dependency>
    <dependency>
      <!-- The shared gateway contract test (runtime-core test-jar). -->
      <groupId>org.tsanet.connector</groupId>
      <artifactId>runtime-core</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <!-- The INVARIANT on the connect-library dependency, as a check instead of
             a comment (#81): dependencyConvergence fails when two different
             versions of connect-library are requested in this module's tree, which
             covers the engine's transitive pin disagreeing with the direct pin
             above. Scoped to that one artifact so an unrelated convergence conflict
             elsewhere in the tree cannot fail the build under this rule's name.
             Bound to validate so it runs in both pipelines: ci.yml's verify and
             image.yml's -DskipTests package. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.6.3</version>
        <executions>
          <execution>
            <id>enforce-connect-library-pin</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <dependencyConvergence>
                  <includes>
                    <include>com.tsanet:connect-library</include>
                  </includes>
                </dependencyConvergence>
              </rules>
              <fail>true</fail>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!-- The sdk-mode RUNNABLE artifact: runtime-core's exec jar alone cannot carry
             this module (the dependency points the other way), so the deployable jar
             for connector.tsanet.mode=sdk is built HERE - runtime-core + connect-library
             + this configuration, launching the same ConnectorApplication. -->
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <classifier>exec</classifier>
          <mainClass>org.tsanet.connector.ConnectorApplication</mainClass>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
