<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.tsanet.connector</groupId>
    <artifactId>tsanet-intercom-connector</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>connect-gateway</artifactId>
  <name>connect-gateway</name>
  <description>SDK-mode assembly: imports the published gateway-engine (docs/decisions.md D6; Fin swap #42) and packages the deployable.</description>

  <properties>
    <gateway-engine.version>0.1.2</gateway-engine.version>
    <connect-library.version>0.2.0</connect-library.version>
  </properties>

  <!-- Where the engine resolves from. GitHub Packages needs a token even for
       reads; the `github` server id in settings.xml carries it. -->
  <repositories>
    <repository>
      <id>github</id>
      <name>GitHub Packages - tsanetgit/Connect_Gateway</name>
      <url>https://maven.pkg.github.com/tsanetgit/Connect_Gateway</url>
      <snapshots><enabled>false</enabled></snapshots>
    </repository>
    <!-- The engine's transitive connect-library lives in the Connect_SDK registry.
         Declared explicitly with its own id rather than relying on the id-collision
         behavior between this pom's `github` and the engine pom's `github`: same
         token, second settings server entry. -->
    <repository>
      <id>github-sdk</id>
      <name>GitHub Packages - tsanetgit/Connect_SDK</name>
      <url>https://maven.pkg.github.com/tsanetgit/Connect_SDK</url>
      <snapshots><enabled>false</enabled></snapshots>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>org.tsanet.connector</groupId>
      <artifactId>runtime-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <!-- The published engine (tsanetgit/Connect_Gateway v0.1.2). Brings
           com.tsanet:connect-library 0.1.0 transitively; this module carries no
           engine sources since the Fin swap (#42) - the frozen copy is retired. -->
      <groupId>org.tsanet.connector</groupId>
      <artifactId>gateway-engine</artifactId>
      <version>${gateway-engine.version}</version>
    </dependency>
    <dependency>
      <!-- Declared directly rather than relying on gateway-engine's transitive 0.1.0
           (D6 forbids this in runtime-core, not here): SdkCacheRetentionSweep calls
           com.tsanet.api.storage.CacheRetention.sweep() straight from Connect_SDK#66,
           since gateway-engine has no wrapper for it (Shawn's explicit call - a
           future adapter redoes this rather than inheriting it). Maven's
           nearest-wins mediation makes this pin win over the engine's transitive
           0.1.0; verified 0.1.0->0.2.0 is additive only for every class the engine
           actually uses (two new source files, nothing pre-existing touched).
           Revisit/remove this pin whenever gateway-engine.version bumps above 0.1.2:
           a later engine may pin a newer connect-library itself, and this direct
           declaration would silently force that back down to whatever is set here. -->
      <groupId>com.tsanet</groupId>
      <artifactId>connect-library</artifactId>
      <version>${connect-library.version}</version>
    </dependency>
    <dependency>
      <!-- The shared gateway contract test (runtime-core test-jar). -->
      <groupId>org.tsanet.connector</groupId>
      <artifactId>runtime-core</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <!-- The sdk-mode RUNNABLE artifact: runtime-core's exec jar alone cannot carry
             this module (the dependency points the other way), so the deployable jar
             for connector.tsanet.mode=sdk is built HERE - runtime-core + connect-library
             + this configuration, launching the same ConnectorApplication. -->
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <classifier>exec</classifier>
          <mainClass>org.tsanet.connector.ConnectorApplication</mainClass>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
