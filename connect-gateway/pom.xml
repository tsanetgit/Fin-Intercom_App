<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.tsanet.connector</groupId>
    <artifactId>tsanet-intercom-connector</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>connect-gateway</artifactId>
  <name>connect-gateway</name>
  <description>Connect SDK binding (com.tsanet:connect-library consumed verbatim; docs/decisions.md D6).</description>

  <dependencies>
    <dependency>
      <groupId>org.tsanet.connector</groupId>
      <artifactId>runtime-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.tsanet</groupId>
      <artifactId>connect-library</artifactId>
      <version>${connect-library.version}</version>
    </dependency>
    <dependency>
      <!-- The shared gateway contract test (runtime-core test-jar). -->
      <groupId>org.tsanet.connector</groupId>
      <artifactId>runtime-core</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <!-- The sdk-mode RUNNABLE artifact: runtime-core's exec jar alone cannot carry
             this module (the dependency points the other way), so the deployable jar
             for connector.tsanet.mode=sdk is built HERE - runtime-core + connect-library
             + this configuration, launching the same ConnectorApplication. -->
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <classifier>exec</classifier>
          <mainClass>org.tsanet.connector.ConnectorApplication</mainClass>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
