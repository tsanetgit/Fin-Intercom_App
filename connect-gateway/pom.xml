<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.tsanet.connector</groupId>
    <artifactId>tsanet-intercom-connector</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>connect-gateway</artifactId>
  <name>connect-gateway</name>
  <description>SDK-mode assembly: imports the published gateway-engine (docs/decisions.md D6; Fin swap #42) and packages the deployable.</description>

  <properties>
    <!-- 2.0.0 = the engine on connect-library 2.0.0 (tsanetgit/Connect_Gateway#37,
         released as v2.0.0). The TsanetGateway contract is unchanged from 1.0.0;
         what moved is login handling: a failed login is a plain GatewayException,
         never the ambiguous GatewayTimeoutException, and a stale token renews in
         a login lane before the operation rather than inside its deadline. -->
    <gateway-engine.version>2.0.0</gateway-engine.version>
    <connect-library.version>2.0.0</connect-library.version>
  </properties>

  <!-- Where the engine resolves from. GitHub Packages needs a token even for
       reads; the `github` server id in settings.xml carries it. -->
  <repositories>
    <repository>
      <id>github</id>
      <name>GitHub Packages - tsanetgit/Connect_Gateway</name>
      <url>https://maven.pkg.github.com/tsanetgit/Connect_Gateway</url>
      <snapshots><enabled>false</enabled></snapshots>
    </repository>
    <!-- The engine's transitive connect-library lives in the Connect_SDK registry.
         Declared explicitly with its own id rather than relying on the id-collision
         behavior between this pom's `github` and the engine pom's `github`: same
         token, second settings server entry. -->
    <repository>
      <id>github-sdk</id>
      <name>GitHub Packages - tsanetgit/Connect_SDK</name>
      <url>https://maven.pkg.github.com/tsanetgit/Connect_SDK</url>
      <snapshots><enabled>false</enabled></snapshots>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>org.tsanet.connector</groupId>
      <artifactId>runtime-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <!-- The published engine (tsanetgit/Connect_Gateway v2.0.0, on the Boot 4 /
           Jackson 3 line from #34). Brings com.tsanet:connect-library 2.0.0
           transitively; this module carries no engine sources since the Fin swap (#42). -->
      <groupId>org.tsanet.connector</groupId>
      <artifactId>gateway-engine</artifactId>
      <version>${gateway-engine.version}</version>
    </dependency>
    <dependency>
      <!-- Declared directly because SdkCacheRetentionSweep compiles against
           com.tsanet.api.storage.CacheRetention (Connect_SDK#66); a direct
           compile-time dependency gets a direct declaration rather than riding the
           engine's graph (D6 forbids com.tsanet.* in runtime-core, not here).
           INVARIANT: this version MUST track gateway-engine's own connect-library
           pin - check the engine pom on every engine bump. Nearest-wins means a
           mismatch here silently overrides the engine's choice (the hazard the
           pre-1.0.0 revision of this comment was about). Both agree at 2.0.0: the
           engine pom at tag v2.0.0 pins connect-library 2.0.0. -->
      <groupId>com.tsanet</groupId>
      <artifactId>connect-library</artifactId>
      <version>${connect-library.version}</version>
    </dependency>
    <dependency>
      <!-- The shared gateway contract test (runtime-core test-jar). -->
      <groupId>org.tsanet.connector</groupId>
      <artifactId>runtime-core</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <!-- The sdk-mode RUNNABLE artifact: runtime-core's exec jar alone cannot carry
             this module (the dependency points the other way), so the deployable jar
             for connector.tsanet.mode=sdk is built HERE - runtime-core + connect-library
             + this configuration, launching the same ConnectorApplication. -->
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <classifier>exec</classifier>
          <mainClass>org.tsanet.connector.ConnectorApplication</mainClass>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
